# Copie este arquivo para .env na raiz do projeto, no servidor.
# .env esta no .gitignore: nunca versione o arquivo real.

# --- Dominio (usado pelo Caddy) ---
DOMAIN=cardapio.seudominio.com.br
ACME_EMAIL=voce@seudominio.com.br

# --- Aplicacao ---
# Senha do usuario "admin" (dono). Use 16+ caracteres.
ADMIN_PASSWORD=troque-por-senha-longa-e-unica

# Gere com: openssl rand -hex 32
AUTH_SECRET=

# Persistencia (o compose forca sqlite e o caminho no volume).
DB_DRIVER=sqlite
SQLITE_PATH=/app/data/app.sqlite

# Cria o usuario de teste "kawan" no primeiro boot. Deixe 0 em producao.
SEED_DEV_USER=0

# --- Storage externo de imagens (opcional) ---
# Sem estas 4 variaveis os uploads vao para o volume app_uploads (disco local).
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_PUBLIC_URL=https://cdn.seudominio.com.br
