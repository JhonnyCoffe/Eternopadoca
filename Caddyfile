{
	email {$ACME_EMAIL}
}

# Dominio principal: HTTPS automatico via Let's Encrypt.
{$DOMAIN} {
	encode zstd gzip

	# Upload de imagem e limitado a 5 MB na aplicacao; 12 MB cobre overhead.
	request_body {
		max_size 12MB
	}

	reverse_proxy app:3000

	header {
		-Server
	}

	log {
		output stdout
		format console
	}
}

# www redireciona para o dominio principal.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
