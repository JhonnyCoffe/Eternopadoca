# Senha do painel administrativo (/admin)
ADMIN_PASSWORD=admin123

# Segredo da sessão (obrigatório em produção; gere com: openssl rand -hex 32)
AUTH_SECRET=

# Persistência: json (padrão) ou sqlite
DB_DRIVER=json
# Opcional: caminho alternativo do arquivo SQLite
# SQLITE_PATH=data/app.sqlite

# Storage de uploads: AWS S3 ou Cloudflare R2.
# Se as 4 variáveis obrigatórias estiverem preenchidas, usa S3/R2.
# Caso contrário, grava em public/uploads (disco local).
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_PUBLIC_URL=https://cdn.seudominio.com.br
