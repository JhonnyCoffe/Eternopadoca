# Senha do painel administrativo (/admin)
# Em producao o app recusa subir sem esta variavel.
ADMIN_PASSWORD=troque-por-senha-longa-e-unica

# Segredo da sessao (obrigatorio em producao; gere com: openssl rand -hex 32)
AUTH_SECRET=

# Persistencia: json (padrao local) ou sqlite
DB_DRIVER=json
# Opcional: caminho alternativo do arquivo SQLite
# SQLITE_PATH=data/app.sqlite

# Cria o usuario de teste "kawan" no seed (padrao: so fora de producao).
# SEED_DEV_USER=1

# Storage de uploads: AWS S3 ou Cloudflare R2.
# Se as 4 variaveis obrigatorias estiverem preenchidas, usa S3/R2.
# Caso contrario, grava em public/uploads (disco local).
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_PUBLIC_URL=https://cdn.seudominio.com.br